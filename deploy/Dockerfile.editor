# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build

# China-friendly apt mirror + BuildKit apt caches (better-sqlite3 native build deps)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    sed -i \
      -e 's|deb.debian.org|mirrors.aliyun.com|g' \
      -e 's|security.debian.org|mirrors.aliyun.com|g' \
      /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
    && npm install -g pnpm@10

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/blog/package.json packages/blog/package.json
COPY packages/editor/package.json packages/editor/package.json
COPY packages/server/package.json packages/server/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter editor build

FROM nginx:1.27-alpine

COPY deploy/nginx/editor.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/editor/dist /usr/share/nginx/html
