# 阿里云 OSS（编辑端图片上传 / 预览）
# 填好后复制为仓库根目录的 .env，勿提交真实密钥
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可带环境前缀：...aliyuncs.com/dev 或 ...aliyuncs.com/prod
BUCKET_URL=
# 可选：若 SDK 需要拆开写，可从 BUCKET_URL 解析或在此显式填写
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket-name
# CDN_DOMAIN=

# 编辑端登录。两项都填写后，文章 / 上传 / 静态化接口需要登录。
# 留空则不鉴权（仅适合本机）。博客预览不走这些接口，保持公开。
EDITOR_USER=
EDITOR_PASSWORD=

# 部署时宿主机端口。改完后重新执行 ./deploy.sh
BLOG_PORT=8080
EDITOR_PORT=8081
